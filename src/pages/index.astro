---
import MainLayout from "../layouts/MainLayout.astro";
import Button from "../components/Button.astro";
import { technologies } from "../data/technologies";
import TechStack from "../components/TechStack.astro";

interface Props {
  items?: string[];
}
---

<MainLayout
  title="Ahmad Muhammad"
  description="Data Engineer · Data Infrastructure & Open Source"
>
  <!-- HERO -->
  <section class="relative mt-10 w-full overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="hero-grid"></div>
    </div>

    <div
      class="relative mx-auto w-full max-w-7xl px-5 sm:px-8 sm:py-12 lg:px-12 xl:px-16"
    >
      <!-- Editorial header -->
      <div
        class="flex items-center justify-between font-mono text-label uppercase text-ink-faint"
      >
        <span>~/index.sh</span>

        <span class="flex items-center gap-2">
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-30"
            ></span>
            <span class="relative h-2 w-2 rounded-full bg-accent"></span>
          </span>
          Available for opportunities
        </span>
      </div>

      <!-- Name -->
      <div class="relative mt-16 sm:mt-20 lg:mt-24">
        <h1
          class="text-display font-semibold leading-[0.84] tracking-[-0.065em] text-ink"
          style="font-size: clamp(4.25rem, 10vw, 9rem);"
        >
          <span class="block">Ahmad</span>
          <span class="mt-1 block">
            Muhammad<span class="text-accent">.</span>
          </span>
        </h1>
      </div>

      <!-- Professional identity -->
      <div
        class="mt-12 grid grid-cols-1 gap-10 pt-7 sm:mt-16 sm:grid-cols-12 sm:gap-8"
      >
        <!-- Role -->
        <div class="sm:col-span-5 lg:col-span-4">
          <div class="border-l-2 border-accent pl-5">
            <p
              class="text-xl font-medium uppercase leading-tight tracking-tight text-ink sm:text-2xl"
            >
              Data Engineer
            </p>

            <p
              class="mt-3 font-mono text-label uppercase leading-relaxed text-ink-faint"
            >
              Data Infrastructure<br />
              & Open Source
            </p>
          </div>

          <div class="mt-8">
            <Button
              href="/contact-me"
              label="Discuss an opportunity"
              class="!bg-accent !text-paper hover:!bg-accent-muted"
            />
          </div>
        </div>

        <!-- Description -->
        <div class="sm:col-span-7 sm:col-start-6 lg:col-span-6 lg:col-start-7">
          <div class="mb-5 flex items-center gap-3">
            <span class="h-px w-8 bg-accent"></span>
            <span
              class="font-mono text-[10px] uppercase tracking-widest text-ink-faint"
            >
              What I build
            </span>
          </div>

          <p
            class="max-w-xl text-xl leading-relaxed tracking-tight text-ink sm:text-2xl"
          >
            I build data infrastructure and developer tooling.
          </p>

          <p class="mt-4 max-w-lg text-body leading-relaxed text-ink-muted">
            Working across data quality, distributed processing, orchestration,
            and open-source engineering.
          </p>
        </div>
      </div>

      <!-- Technology index -->
      <div class="mt-16 border-t border-line-muted pt-5 sm:mt-20">
        <div class="mb-4 flex items-center justify-between">
          <span class="font-mono text-label uppercase text-ink-faint">
            Technologies & domains
          </span>

          <span
            class="font-mono text-[9px] uppercase tracking-widest text-ink-faint"
          >
            01 — 04
          </span>
        </div>

        <div
          class="flex flex-wrap gap-x-6 gap-y-3 font-mono text-label font-medium uppercase text-ink-muted"
        >
          <TechStack items={technologies} />
        </div>
      </div>
    </div>
  </section>

  <section
    class="relative mx-auto mt-16 w-full max-w-7xl px-5 sm:mt-36 sm:px-8 lg:px-12"
  >
    <div
      class="flex items-center justify-between border-t border-line pt-3 font-mono text-[10px] uppercase tracking-wider text-ink-faint"
    >
      <span>02 / Experience</span>
      <span>Professional practice</span>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-8">
      <!-- Position metadata -->
      <div class="md:col-span-3">
        <span
          class="font-mono text-[10px] uppercase tracking-widest text-accent"
        >
          February 2025 — Present
        </span>

        <p class="mt-5 text-sm font-medium text-ink">
          National Telecom Regulatory Authority
        </p>

        <p class="mt-2 text-xs leading-6 text-ink-muted">
          Egypt · Smart Village<br />
          Technical Office
        </p>

        <p
          class="mt-8 font-mono text-[10px] uppercase tracking-widest text-ink-faint"
        >
          Data Analytics &<br />
          Decision Support
        </p>
      </div>

      <!-- Experience -->
      <div class="md:col-span-8 md:col-start-5">
        <h2
          class="max-w-3xl text-3xl font-medium leading-tight tracking-[-0.055em] text-ink sm:text-4xl lg:text-5xl"
        >
          Building the data infrastructure.
        </h2>

        <div class="mt-12">
          <article
            class="grid grid-cols-[2rem_1fr] gap-4 py-6 sm:grid-cols-[3rem_1fr] sm:gap-6"
          >
            <span class="font-mono text-xs text-accent">01</span>

            <div>
              <h3 class="text-base font-medium text-ink">
                Ingestion & orchestration
              </h3>

              <p class="mt-3 max-w-2xl text-sm leading-7 text-ink-muted">
                Built a configurable Python ingestion framework for inconsistent
                Excel reporting formats, reducing manual data correction effort
                by approximately 98%. Developed pipelines factories to
                standardize ingestion and execution.
              </p>
            </div>
          </article>

          <article
            class="grid grid-cols-[2rem_1fr] gap-4 py-6 sm:grid-cols-[3rem_1fr] sm:gap-6"
          >
            <span class="font-mono text-xs text-accent">02</span>

            <div>
              <h3 class="text-base font-medium text-ink">
                Data quality & validation
              </h3>

              <p class="mt-3 max-w-2xl text-sm leading-7 text-ink-muted">
                Developed a Spark-based data contract and validation engine to
                enforce business rules, validate schemas, and quarantine invalid
                records, with automated notifications and business-friendly
                quality reports.
              </p>
            </div>
          </article>

          <article
            class="grid grid-cols-[2rem_1fr] gap-4 py-6 sm:grid-cols-[3rem_1fr] sm:gap-6"
          >
            <span class="font-mono text-xs text-accent">03</span>

            <div>
              <h3 class="text-base font-medium text-ink">
                Analytics performance
              </h3>

              <p class="mt-3 max-w-2xl text-sm leading-7 text-ink-muted">
                Re-engineered legacy analytics dashboards, reducing response
                times from over four minutes to approximately five seconds
                through query optimization, rendering improvements, and caching
                redesign.
              </p>
            </div>
          </article>
        </div>

        <div class="mt-8">
          <Button
            href="/contact-me"
            label="Discuss an opportunity"
            class="!bg-accent !text-paper hover:!bg-accent-muted"
          />
        </div>
      </div>
    </div>
  </section>

  <section
    class="relative mx-auto mt-24 w-full max-w-7xl px-5 sm:mt-32 sm:px-8 lg:px-12"
  >
    <!-- Editorial header -->
    <div
      class="grid grid-cols-2 border-t border-line pt-3 font-mono text-[10px] uppercase tracking-wider text-ink-faint sm:grid-cols-4"
    >
      <span>01 / Selected work</span>
      <span class="hidden sm:block">Open source</span>
      <span class="text-right sm:text-left">Data quality</span>
      <span class="text-right">2026 — Present</span>
    </div>

    <!-- Project identity -->
    <div class="mt-16 grid grid-cols-1 gap-8 md:mt-24 md:grid-cols-12 md:gap-6">
      <div class="md:col-span-9">
        <h2
          class="text-ink font-semibold leading-[0.78] tracking-[-0.095em]"
          style="font-size:clamp(5rem, 17vw, 15rem)"
        >
          native<span class="text-[#FF6B45]">dq</span>
        </h2>
      </div>

      <div
        class="flex flex-col justify-between border-l border-line pl-5 md:col-span-3 md:mt-2"
      >
        <span
          class="font-mono text-[10px] uppercase tracking-widest text-ink-faint"
        >
          Independent project / 001
        </span>

        <p class="mt-8 max-w-[15rem] text-sm leading-6 text-ink-muted">
          An open-source framework for defining, executing and inspecting data
          quality tests.
        </p>

        <div class="mt-3">
          <Button
            label="Explore NativeDQ"
            ,
            href="https://github.com/ahmadMuhammadGd/nativedq"
            ,
            class="!bg-accent !text-paper hover:!bg-accent-muted"
          />
        </div>
      </div>
    </div>

    <!-- Core proposition -->
    <div
      class="mt-20 grid grid-cols-1 gap-10 border-line pt-8 md:mt-28 md:grid-cols-12"
    >
      <div class="md:col-span-3">
        <span
          class="font-mono text-[10px] uppercase tracking-widest text-ink-faint"
        >
          The proposition
        </span>
        <div class="mt-8 hidden font-mono text-xs text-ink-faint md:block">
          01 — 02
        </div>
      </div>

      <div class="md:col-span-9">
        <h3
          class="max-w-5xl text-4xl font-medium leading-[1.08] tracking-[-0.055em] sm:text-6xl lg:text-7xl"
        >
          Write tests in Python. Understand every
          <span class="text-accent">failure.</span>
        </h3>

        <div class="mt-8 flex items-center justify-between pb-5">
          <p class="max-w-xl text-sm leading-7 text-ink-muted">
            Data quality should be defined in the language of the data engineer
            and produce results that can be investigated, queried and reused.
          </p>
          <!-- <img src="/nativedq-logo-light.svg" alt="NativeDQ"
             class="hidden h-12 w-auto dark:hidden sm:block" />
        <img src="/nativedq-logo-dark.svg" alt="NativeDQ"
             class="hidden h-12 w-auto dark:block" /> -->
        </div>
      </div>
    </div>

    <!-- Project rationale -->
    <div class="mt-20 grid grid-cols-1 gap-10 pt-0 md:mt-28 md:grid-cols-12">
      <div class="md:col-span-3">
        <span
          class="font-mono text-[10px] uppercase tracking-widest text-ink-faint"
        >
          Why it exists
        </span>
      </div>

      <div class="md:col-span-9">
        <p
          class="max-w-4xl text-2xl leading-[1.35] tracking-[-0.035em] text-ink sm:text-3xl"
        >
          Data quality tools often tell you that something failed. They don't
          always make it easy to understand what failed, why.
        </p>

        <p class="mt-6 mb-6 max-w-2xl text-sm leading-7 text-ink-muted">
          NativeDQ explores a different approach: Python-native test
          definitions, structured row-level results and alignment with open data
          contract specifications.
        </p>

        <Button
          href="https://github.com/ahmadMuhammadGd/nativedq"
          label="Explore NativeDQ"
          class="!bg-accent !text-paper hover:!bg-accent-muted"
        />
      </div>
    </div>
    <!-- </div> -->
  </section>

  <!-- Selected Work -->
  <section
    class="relative mx-auto mt-24 w-full max-w-7xl px-5 sm:mt-36 sm:px-8 lg:px-12"
  >
    <div
      class="flex items-center justify-between border-t border-line pt-3 font-mono text-[10px] uppercase tracking-wider text-ink-faint"
    >
      <span>04 / Selected writing</span>
      <span>Systems & engineering</span>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <h2
          class="text-4xl font-medium leading-[1.05] tracking-[-0.06em] text-ink sm:text-6xl lg:text-7xl"
        >
          Thinking through
          <span class="text-accent">engineering.</span>
        </h2>
      </div>

      <div class="md:col-span-4 md:col-start-9">
        <p class="text-sm leading-7 text-ink-muted">
          Notes on data systems, infrastructure,
          <!-- software engineering, -->
          and the decisions behind building reliable tools.
        </p>

        <div class="mt-6">
          <Button
            href="/writing"
            label="ALL WRITING"
            class="!bg-accent !text-paper hover:!bg-accent-muted"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 04 / DISCUSS AN OPPORTUNITY -->
  <section
    class="relative mx-auto w-full max-w-7xl px-5 sm:mt-24 sm:px-8 lg:px-12"
  >
    <div
      class="flex items-center justify-between font-mono text-label uppercase text-ink-faint mb-20 border-t border-line pt-3"
    >
      <span>03 / DISCUSS AN OPPORTUNITY</span>

      <span>Contact me</span>
    </div>

    <div class="mt-10 grid gap-10 md:grid-cols-[180px_1fr] md:gap-12">
      <!-- label -->
      <div>
        <div class="flex items-center gap-3">
          <span class="h-px w-7 bg-accent"></span>

          <p class="font-mono text-label uppercase text-ink-muted">
            DISCUSS AN OPPORTUNITY
          </p>
        </div>
      </div>

      <div class="max-w-3xl">
        <p
          class="text-xl leading-8 text-ink sm:text-2xl sm:leading-9 lg:text-3xl lg:leading-[1.35]"
        >
          Have an interesting data engineering problem?
        </p>
        <p
          class="text-xl leading-8 text-ink sm:text-2xl sm:leading-9 lg:text-3xl lg:leading-[1.35]"
        >
          I'm open to discussing opportunities involving data infrastructure,
          distributed processing, data quality, and developer tooling.
        </p>

        <div class="mt-8">
          <Button
            href="/contact-me"
            label="Discuss an opportunity"
            class="!bg-accent !text-paper hover:!bg-accent-muted"
          />
        </div>
      </div>
    </div>
  </section>
</MainLayout>
