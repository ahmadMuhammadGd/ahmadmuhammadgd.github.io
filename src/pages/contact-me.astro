---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Contact"
  description="Get in touch with Ahmad Muhammad about data engineering, data infrastructure, and open-source work."
>
  <main class="mx-auto w-full max-w-content px-4 sm:px-8 lg:px-10">

    <section class="py-20 sm:py-28">

      <div class="grid grid-cols-1 gap-10 sm:grid-cols-12 sm:gap-8">

        <div class="sm:col-span-3">
          <span class="font-mono text-xs uppercase tracking-wide text-ink-faint">
            ~/contact
          </span>
        </div>

        <div class="sm:col-span-8 sm:col-start-4">

          <p class="font-mono text-xs uppercase tracking-wide text-accent">
            Open to opportunities
          </p>

          <h1 class="mt-6 max-w-3xl text-4xl font-medium tracking-tight text-ink sm:text-6xl">
            Have something worth building?
          </h1>

          <p class="mt-7 max-w-xl text-base leading-8 text-ink-muted">
            I'm interested in conversations around data engineering,
            infrastructure, distributed processing, data quality, and
            open-source tooling.
          </p>

          <p class="mt-4 max-w-xl text-sm leading-7 text-ink-muted">
            If you're building in these areas or have an opportunity
            worth discussing, reach out through one of the channels below.
          </p>

        </div>
      </div>
    </section>

    <section class="border-t border-line py-12 sm:py-16">

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-12 sm:gap-8">

        <div class="sm:col-span-3">
          <span class="font-mono text-xs uppercase tracking-wide text-ink-faint">
            01 / Find me
          </span>
        </div>

        <div class="sm:col-span-8 sm:col-start-4">
<a
  href="https://www.linkedin.com/in/ahmadmuhammadgd/"
  target="_blank"
  rel="noopener noreferrer"
  class="group flex items-center justify-between py-10 no-underline"
>
  <div class="flex items-center gap-4">
    <svg
      viewBox="0 0 24 24"
      class="h-5 w-5 fill-current text-ink-muted transition-colors group-hover:text-accent"
      aria-hidden="true"
    >
      <path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM8.1 18.45H5.15V9h2.95v9.45ZM6.62 7.71a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm11.83 10.74H15.5v-4.6c0-1.1-.02-2.51-1.53-2.51-1.53 0-1.77 1.2-1.77 2.43v4.68H9.25V9h2.83v1.29h.04c.39-.74 1.35-1.53 2.78-1.53 2.98 0 3.55 1.96 3.55 4.51v5.18Z"/>
    </svg>

    <div>
      <h2 class="font-mono text-sm uppercase tracking-wide text-ink transition-colors group-hover:text-accent">
        LinkedIn
      </h2>
      <p class="mt-2 text-sm text-ink-muted">
        Professional conversations and opportunities
      </p>
    </div>
  </div>

  <span class="font-mono text-sm text-ink-muted transition-colors group-hover:text-accent">↗</span>
</a>

<a
  href="https://github.com/ahmadMuhammadGd"
  target="_blank"
  rel="noopener noreferrer"
  class="group flex items-center justify-between py-6 no-underline"
>
  <div class="flex items-center gap-4">
    <svg
      viewBox="0 0 24 24"
      class="h-5 w-5 fill-current text-ink-muted transition-colors group-hover:text-accent"
      aria-hidden="true"
    >
      <path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.31-3.76-1.31-.5-1.29-1.24-1.63-1.24-1.63-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 .1.76 2.02 3.19 1.42.1-.71.39-1.19.71-1.47-2.47-.28-5.06-1.24-5.06-5.5 0-1.21.43-2.2 1.15-2.97-.12-.28-.5-1.41.11-2.93 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.11-1.44 3.05-1.14 3.05-1.14.61 1.52.23 2.65.11 2.93.72.77 1.15 1.76 1.15 2.97 0 4.27-2.6 5.21-5.08 5.49.4.35.76 1.02.76 2.06v3.07c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/>
    </svg>

    <div>
      <h2 class="font-mono text-sm uppercase tracking-wide text-ink transition-colors group-hover:text-accent">
        GitHub
      </h2>
      <p class="mt-2 text-sm text-ink-muted">
        Projects, experiments, and open-source work
      </p>
    </div>
  </div>

  <span class="font-mono text-sm text-ink-muted transition-colors group-hover:text-accent">↗</span>
</a>

        </div>
      </div>
    </section>

  </main>
</MainLayout>