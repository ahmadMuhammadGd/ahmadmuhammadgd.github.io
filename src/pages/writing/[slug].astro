---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import Metric from '../../components/MetricCard.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);

const metrics = project.data.metrics ?? [];
const tags = project.data.tags ?? [];
---

<MainLayout
  title={project.data.title}
  description={project.data.description}
>

  <article class="mx-auto mt-12 w-full max-w-7xl px-5 sm:mt-16 sm:px-8 lg:px-12">


    <!-- Project identity -->
    <header class="border-b border-line pb-10 pt-12 sm:pt-20">
      <div class="grid gap-8 md:grid-cols-[1fr_240px] md:gap-16">

        <div>
          <p class="mb-5 font-mono text-label uppercase text-ink-faint">
            ~/ahmad/work/{project.id}
          </p>

          <h1 class="text-display text-ink">
            {project.data.title}
          </h1>

          <p class="mt-10 max-w-reading text-xl leading-8 text-ink-muted">
            {project.data.description}
          </p>
        </div>

        <div class="md:pt-8">
          <div class="font-mono text-label uppercase text-ink-faint">
            Stack
          </div>

          <div class="mt-3 flex flex-wrap gap-x-3 gap-y-2">
            {
              tags.map((tag: string) => (
                <span class="font-mono text-xs text-ink-muted">
                  {tag}
                </span>
              ))
            }
          </div>
        </div>

      </div>
    </header>


    <!-- Evidence -->
    {
      metrics.length > 0 && (
        <section class="relative mx-auto mt-20 w-full max-w-7xl px-5 sm:mt-24 sm:px-8 lg:px-12">            
          <div class="grid grid-cols-2 md:grid-cols-4">
            {metrics.map((metric) => (
              <div class="border-b border-line px-4 py-6 last:border-b-0 md:border-b-0 md:border-r md:px-6 md:last:border-r-0">
                <Metric
                  metric={metric.value}
                  description={metric.label}
                />
              </div>
            ))}
          </div>
        </section>
      )
}

<!-- Case study -->
  <div class="grid gap-8 md:grid-cols-[160px_minmax(0,1fr)] md:gap-16">

    <aside class="hidden md:block">
      <div class="sticky top-24 font-mono text-label uppercase text-ink-faint">
        Case Study
      </div>
    </aside>

    <div class="min-w-0">
      <div class="prose max-w-reading">
        <Content />
      </div>
    </div>

  </div>


    <!-- Navigation -->
    <footer class="mt-20 border-t border-line py-8">
      <a
        href="/work"
        class="font-mono text-xs text-accent underline decoration-accent/30 underline-offset-4 transition-colors hover:text-accent-muted"
      >
        ← All work
      </a>
    </footer>

  </article>

</MainLayout>