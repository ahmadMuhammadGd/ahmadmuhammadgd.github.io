
---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div class="flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-sm text-ink-muted uppercase">
  {items.map((item, index) => (
    <>
      {index > 0 && <span aria-hidden="true">-</span>}
      <span>{item}</span>
    </>
  ))}
</div>
