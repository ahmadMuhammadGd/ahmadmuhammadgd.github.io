
---
export interface Props {
  title: string;
  description: string;
  tags: string[];
  url: string;
  coverImage?: string | null;
  index?: number;
}

const {
  title,
  description,
  tags,
  url,
  coverImage,
  index = 1,
} = Astro.props;

const number = String(index).padStart(2, "0");
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group relative grid gap-5 py-7 transition-colors duration-300 md:grid-cols-[56px_1fr_180px_auto] md:items-center md:gap-8"
>
  <!-- Number -->
  <div class="flex items-center gap-1 self-start pt-1">
    <span
      class="font-mono text-label text-ink-faint transition-colors duration-300 group-hover:text-accent"
    >
      {number}
    </span>

    <span
      class="hidden h-px w-10 bg-line transition-all duration-300 group-hover:w-0 group-hover:bg-accent md:block"
    ></span>
  </div>

  <!-- Content -->
  <div class="max-w-3xl">
    <h3
      class="text-title text-ink transition-all duration-300 group-hover:translate-x-2 group-hover:text-accent"
    >
      {title}
    </h3>

    <p class="mt-3 max-w-2xl text-sm leading-6 text-ink-muted">
      {description}
    </p>

    <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
      {tags.slice(0, 5).map((tag) => (
        <span class="font-mono text-label uppercase text-ink-faint">
          {tag}
        </span>
      ))}
    </div>
  </div>

  <!-- Editorial cover -->
<div
  class="relative hidden aspect-[16/10] w-full overflow-hidden bg-surface-muted md:block"
>
    {coverImage ? (
      <img
        src={coverImage}
        alt=""
        loading="lazy"
        class="h-full w-full object-contain grayscale opacity-75 transition-all duration-500 group-hover:grayscale-0 group-hover:opacity-100"
      />
    ) : (
      <div
        class="flex h-full items-center justify-center border border-line font-mono text-label text-ink-faint"
      >
        {number} / NOTE
      </div>
    )}

    <div class="pointer-events-none absolute inset-0 border border-line/50"></div>
  </div>

  <!-- Action -->
  <div
    class="flex items-center gap-3 pt-1 font-mono text-label uppercase text-ink-faint transition-colors duration-300 group-hover:text-accent"
  >
    <span
      class="hidden h-px w-0 bg-accent transition-all duration-300 group-hover:w-5 md:block"
    ></span>

    <span>Read</span>

    <span
      class="inline-block transition-transform duration-300 group-hover:translate-x-1"
    >
      ↗
    </span>
  </div>
</a>
